# ── Palworld Dedicated Server — environment variables ──────────────────────────
# Copy this file to .env, fill in the values you want, and import via
# `railway variables set --from-file .env` or paste into the Railway dashboard.
#
# These map to the upstream image's env vars (thijsvanloef/palworld-server-docker).
# The Railway template uses dynamic refs (${{...}}) for cross-service wiring.

# ── Networking ────────────────────────────────────────────────────────────────
# Game port (UDP + TCP). MUST be 8211 — Railway injects PORT=8080 on services
# without an explicit PORT var, which would break the game port mapping.
PORT=8211

# REST API port (TCP). Used for Railway healthcheck since Railway doesn't
# support UDP healthchecks. Set to 8212.
REST_API_PORT=8212

# Query port (Steam server browser). Default 27015.
QUERY_PORT=27015

# RCON port (remote console). Default 25575.
RCON_PORT=25575

# ── Server Identity ───────────────────────────────────────────────────────────
# Server name shown in the server browser.
SERVER_NAME=My Palworld Server

# Server description (optional).
SERVER_DESCRIPTION=Hosted on Railway

# Server password (leave empty for public).
SERVER_PASSWORD=

# Admin password (RCON/REST API admin).
ADMIN_PASSWORD=change-me

# Max players (1-32).
PLAYERS=16

# Enable community server (shows in server browser).
COMMUNITY=true

# Public IP (auto-detected if empty).
PUBLIC_IP=

# Public port (defaults to PORT if empty).
PUBLIC_PORT=

# ── RCON ─────────────────────────────────────────────────────────────────────
# Enable RCON for remote console access.
RCON_ENABLED=false

# ── REST API ─────────────────────────────────────────────────────────────────
# Enable REST API (required for Railway healthcheck).
REST_API_ENABLED=true

# ── Backups ──────────────────────────────────────────────────────────────────
# Enable automated backups (cron-based).
BACKUP_ENABLED=true

# Cron expression for backups (default: daily at midnight).
BACKUP_CRON_EXPRESSION=0 0 * * *

# Delete old backups after N days.
DELETE_OLD_BACKUPS=false
OLD_BACKUP_DAYS=30

# ── Updates ──────────────────────────────────────────────────────────────────
# Update server on boot.
UPDATE_ON_BOOT=true

# Enable automatic updates (cron-based).
AUTO_UPDATE_ENABLED=false
AUTO_UPDATE_CRON_EXPRESSION=0 * * * *
AUTO_UPDATE_WARN_MINUTES=30

# ── Auto Reboot ──────────────────────────────────────────────────────────────
# Enable automatic reboots (cron-based).
AUTO_REBOOT_ENABLED=false
AUTO_REBOOT_CRON_EXPRESSION=0 0 * * *
AUTO_REBOOT_WARN_MINUTES=5
AUTO_REBOOT_EVEN_IF_PLAYERS_ONLINE=false

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=UTC

# ── Discord (optional) ──────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
DISCORD_PRE_BACKUP_MESSAGE=Creating backup...
DISCORD_POST_BACKUP_MESSAGE=Backup created at file_path
DISCORD_PRE_START_MESSAGE=Server has been started!
DISCORD_PRE_SHUTDOWN_MESSAGE=Server is shutting down...
DISCORD_POST_SHUTDOWN_MESSAGE=Server has been stopped!
DISCORD_PLAYER_JOIN_MESSAGE=player_name has joined Palworld!
DISCORD_PLAYER_LEAVE_MESSAGE=player_name has left Palworld.
